{
  "name": "crossgram-android-patcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.9.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "brand": "tsx src/cli.ts brand",
    "check": "tsc -p tsconfig.json --noEmit && vitest run",
    "patch:source": "tsx src/cli.ts patch",
    "discover": "tsx src/cli.ts discover",
    "e2e:source": "tsx src/cli.ts e2e",
    "e2e:android-server": "node scripts/e2e/android-server.mjs",
    "inspect:android-cache": "node scripts/e2e/inspect-android-cache.mjs",
    "prepare-build": "tsx src/cli.ts prepare-build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
